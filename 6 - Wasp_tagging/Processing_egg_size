# EGG SIZE R SCRIPT

library(tidyr)
library(cowplot)
library(ggpol)

# Copy-paste the ovary dissection results Excel sheet into its own document, and 
# import it into R as 'tempfile_ImportDissectionResults':

View(Ovary_dissections_table)
tempfile_ImportDissectionResults <- Ovary_dissections_table

# First, focus on the subset of the data that comprises rows with largest-egg measurements (keeping wasps with no oocytes as '0') *and* with dominance categorisations:
WaspsWithEggMeasurementsAndDominanceCategorisation <- drop_na(tempfile_ImportDissectionResults,c(LargestEgg,DominanceCode))
View(WaspsWithEggMeasurementsAndDominanceCategorisation)
WaspsWithEggMeasurementsAndDominanceCategorisation$LargestEgg <- as.numeric(WaspsWithEggMeasurementsAndDominanceCategorisation$LargestEgg)
WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory <- as.factor(WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory)

# There are two foundresses with no oocytes at all (both in South Africa). 
# To plot largest egg sizes in all other wasps, we remove these wasps from the plot:
WaspsWithEggMeasurementsAndDominanceCategorisation <- subset(WaspsWithEggMeasurementsAndDominanceCategorisation,WaspsWithEggMeasurementsAndDominanceCategorisation$LargestEgg>0)

# Quick overview plot using violin plot:
library(ggrain)
ggplot(WaspsWithEggMeasurementsAndDominanceCategorisation, aes(x = FoundressDominanceCategory, y = LargestEgg, fill=Climate)) +
  geom_rain(rain.side = 'l') + theme_cowplot()

myColors <- c("#56ddc5","orange","red")
myfontsize <- 10

# Generate boxplots (following https://github.com/erocoar/ggpol):
largestegg.plot <- ggplot(WaspsWithEggMeasurementsAndDominanceCategorisation) + 
  geom_boxjitter(aes(x = FoundressDominanceCategory, 
                     y = LargestEgg, 
                     fill = Climate),
                 jitter.shape = 21, 
                 jitter.color = NA, 
                 jitter.alpha = 0.5,
                 jitter.size = 0.3,
                 jitter.params = list(height = 0, width = 0.09),
                 outlier.color = 1, outlier.fill = 1, outlier.shape = 21,
                 errorbar.draw = TRUE) + 
  scale_fill_manual(values = myColors) + 
  expand_limits(y=c(0,2.5)) +
  scale_y_continuous(breaks = seq(0,2.3,by = 0.5),expand = c(0, 0)) +
  theme_cowplot(font_size = myfontsize) + 
  theme(text = element_text(size=20)) +
  labs(y= "Largest egg (mm)", 
       x = "Social role") + 
  theme(legend.position="none") + 
  theme(axis.line.x.bottom=element_line(size=0.5)) +
  theme(axis.line.y.left=element_line(size=0.5)) +
  theme(axis.text.x = element_text(color = "black", size = 12, angle = 90, hjust = .5, vjust = .5, face = "plain"),
        axis.text.y = element_text(color = "black", size = 12, angle = 0, hjust = 1, vjust = 0, face = "plain"),  
        axis.title.x = element_text(color = "black", size = 12, angle = 0, hjust = .5, vjust = 0, face = "plain"),
        axis.title.y = element_text(color = "black", size = 12, angle = 90, hjust = .5, vjust = .5, face = "plain"))
largestegg.plot

# ----------------------------------------------------------------------
# STATS ON THE PLOTTED DATA (following https://statsandr.com/blog/anova-in-r/):

# Sample sizes:
sum(WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory=="Humid tropics D")
sum(WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory=="Temperate D")
sum(WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory=="Humid tropics S")
sum(WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory=="Temperate S")
sum(WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory=="Semi-arid D")

# Run ANOVA:
largestegg.res_aov <- aov(LargestEgg ~ FoundressDominanceCategory, 
                          data = WaspsWithEggMeasurementsAndDominanceCategorisation)
summary(largestegg.res_aov)

# Check for normality (https://statsandr.com/blog/anova-in-r/):
# First, with histogram:
hist(largestegg.res_aov$residuals)
# Second, with Q-Q plot:
library(car)
qqPlot(largestegg.res_aov$residuals, id = FALSE) # id = FALSE to remove point identification
# Third, with Shapiro-Wilk test:
shapiro.test(largestegg.res_aov$residuals)
# If the p-value is less than 0.05, we would reject the null hypothesis of a normal distribution.

# SHAPIRO-WILK OUTPUT (2nd August 2024):
## Shapiro-Wilk normality test
## data:  largestegg.res_aov$residuals
## W = 0.96748, p-value = 2.049e-05

# Since the data is highly non-normal, we will use a Kruskal-Wallis test instead of ANOVA:

largestegg.kruskal_wallis <- kruskal.test(LargestEgg ~ FoundressDominanceCategory, 
                                          data = WaspsWithEggMeasurementsAndDominanceCategorisation)
largestegg.kruskal_wallis

# KRUSKAL-WALLIS TEST OUTPUT (2nd August 2024):
## Kruskal-Wallis rank sum test
## data:  LargestEgg by FoundressDominanceCategory
## Kruskal-Wallis chi-squared = 101.18, df = 4, p-value < 2.2e-16

# Since there is a significant effect in the Kruskal-Wallis test, we can use Wilcox
# tests for pairwise comparisons:

pairwise.wilcox.test(WaspsWithEggMeasurementsAndDominanceCategorisation$LargestEgg, 
                     WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory,
                     p.adjust.method = "BH")

# WILCOX PAIRWISE TEST OUTPUT (20TH JANUARY 2024):
##	Pairwise comparisons using Wilcoxon rank sum test with continuity correction 
##	
##	data:  WaspsWithEggMeasurementsAndDominanceCategorisation$LargestEgg and WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory 
##	
##	                Humid tropics D Humid tropics S Semi-arid D Temperate D
##	Humid tropics S   0.00021         -               -           -          
##	  Semi-arid D     4.4e-05         0.00675         -           -          
##	  Temperate D     0.00117         4.2e-07         6.2e-13     -          
##	  Temperate S     7.2e-07         0.21168         1.9e-08     3.5e-11    
##	
##	P value adjustment method: BH 
# (Note that *exact* p-values cannot be computed with ties).

# In the Wilcox pairwise test output above, there is a significant 
# difference between Humid tropics D and all other categories (including Temperate D). The only categories
# without a significant difference are Temperate S and Humid tropics S. We therefore add a,b,c,b as 
# significance letters to the plot below.

# Since Wilcox pairwise comparisons find significant effects, *manually* plot the significance letters on the graph using the following:

largestegg.annotation <- data.frame(
  x = c(1, 2, 3, 4, 5),
  y = c(0.2+max(subset(WaspsWithEggMeasurementsAndDominanceCategorisation,WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory=="Humid tropics D")$LargestEgg),
        0.2+max(subset(WaspsWithEggMeasurementsAndDominanceCategorisation,WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory=="Humid tropics S")$LargestEgg),
        0.2+max(subset(WaspsWithEggMeasurementsAndDominanceCategorisation,WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory=="Semi-arid D")$LargestEgg),
        0.2+max(subset(WaspsWithEggMeasurementsAndDominanceCategorisation,WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory=="Temperate D")$LargestEgg),
        0.2+max(subset(WaspsWithEggMeasurementsAndDominanceCategorisation,WaspsWithEggMeasurementsAndDominanceCategorisation$FoundressDominanceCategory=="Temperate S")$LargestEgg)),
  label = c("a","b","c","d","b"))

# Add text
largestegg.plot <- largestegg.plot + 
  geom_text(data=largestegg.annotation, 
            aes(x=x, y=y, label=label),
            size=4)
largestegg.plot

