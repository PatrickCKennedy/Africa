WaspsWithStageAndDominanceCategorisation$Stage_d_OrNot[WaspsWithStageAndDominanceCategorisation$Stage=="d"] = 1

model = glm(Stage_d_OrNot ~ DominanceCode + Country + Country*DominanceCode, family = 'binomial', data = WaspsWithStageAndDominanceCategorisation)
summary(model)

