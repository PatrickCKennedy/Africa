        # Run simple logistic regression with just one predictor variable:
        model = glm(ActiveOrNot ~ FoundressDominanceCategory, family = 'binomial', data = WaspsWithStageAndDominanceCategorisation)
        summary(model)

        # To make the comparisons relative to South African subordinates, we change the reference group to "SA S":
        # Choose the reference group (following https://quantifyinghealth.com/logistic-regression-in-r-with-categorical-variables/):
        WaspsWithStageAndDominanceCategorisation$FoundressDominanceCategory = relevel(factor(WaspsWithStageAndDominanceCategorisation$FoundressDominanceCategory), ref = "SA S")
        
        # Rerun simple logistic regression with the new reference group:
        model = glm(ActiveOrNot ~ FoundressDominanceCategory, family = 'binomial', data = WaspsWithStageAndDominanceCategorisation)
        summary(model)

