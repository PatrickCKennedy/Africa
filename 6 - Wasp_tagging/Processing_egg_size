# STATISTICS ON OVARY GRADE:

# Stage 'd' is maximum activity. We use a simple logistic regression with stage 'd' or not as response variable:

WaspsWithStageAndDominanceCategorisation$Stage_d_OrNot = 0
WaspsWithStageAndDominanceCategorisation$Stage_d_OrNot[WaspsWithStageAndDominanceCategorisation$Stage=="d"] = 1

model = glm(Stage_d_OrNot ~ DominanceCode + Climate + Climate*DominanceCode, family = 'binomial', data = WaspsWithStageAndDominanceCategorisation)
summary(model)

