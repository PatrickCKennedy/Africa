# STATISTICS ON OVARY GRADE:

# We consider grades 'c' and 'd' to be 'active', and all other grades to be 'inactive'. We then use a
# logistic regression on active versus inactive ovaries for the four categories.
        # Add a column to say whether the wasp has c or d ovaries ('1' if so and '0' if not):
        WaspsWithStageAndDominanceCategorisation$ActiveOrNot = NA
        WaspsWithStageAndDominanceCategorisation$ActiveOrNot[WaspsWithStageAndDominanceCategorisation$Stage=="a"] = 0
        WaspsWithStageAndDominanceCategorisation$ActiveOrNot[WaspsWithStageAndDominanceCategorisation$Stage=="b"] = 0
        WaspsWithStageAndDominanceCategorisation$ActiveOrNot[WaspsWithStageAndDominanceCategorisation$Stage=="c"] = 1
        WaspsWithStageAndDominanceCategorisation$ActiveOrNot[WaspsWithStageAndDominanceCategorisation$Stage=="d"] = 1
        WaspsWithStageAndDominanceCategorisation$ActiveOrNot[WaspsWithStageAndDominanceCategorisation$Stage=="e"] = 0

        # Run simple logistic regression with just one predictor variable:
        model = glm(ActiveOrNot ~ FoundressDominanceCategory, family = 'binomial', data = WaspsWithStageAndDominanceCategorisation)
        summary(model)

        # To make the comparisons relative to South African subordinates, we change the reference group to "SA S":
        # Choose the reference group (following https://quantifyinghealth.com/logistic-regression-in-r-with-categorical-variables/):
        WaspsWithStageAndDominanceCategorisation$FoundressDominanceCategory = relevel(factor(WaspsWithStageAndDominanceCategorisation$FoundressDominanceCategory), ref = "SA S")
        
        # Rerun simple logistic regression with the new reference group:
        model = glm(ActiveOrNot ~ FoundressDominanceCategory, family = 'binomial', data = WaspsWithStageAndDominanceCategorisation)
        summary(model)

