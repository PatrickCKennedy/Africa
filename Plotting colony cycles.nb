Cell[CellGroupData[{

Cell["(3) Plotting post-emergence nests:", "Section",
 CellChangeTimes->{{3.8784107704028244`*^9, 3.8784107936586847`*^9}, {
  3.8784132354172964`*^9, 3.8784132529099474`*^9}, {3.8784137398154984`*^9, 
  3.878413744628504*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"MyRow", "=", "8"}], ";"}]], "Input",
 CellChangeTimes->{{3.878414386486767*^9, 3.878414390055952*^9}}],

Cell["\<\
Post-emergence nest observations are in row 8 (which is data[[8]]). 

Transpose the points, so that it is in a usable format:\
\>", "Text",
 CellChangeTimes->{{3.878410756243881*^9, 3.878410766997532*^9}, {
  3.8784108021181097`*^9, 3.878410821053404*^9}, {3.8784132552438354`*^9, 
  3.878413276138863*^9}, {3.8784137666170473`*^9, 3.8784137738826423`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pts", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"data", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", 
      FractionBox[
       RowBox[{"data", "[", 
        RowBox[{"[", "MyRow", "]"}], "]"}], 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"data", "[", 
          RowBox[{"[", "MyRow", "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]]}], "}"}], "]"}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pts", "=", 
   RowBox[{"pts", "[", 
    RowBox[{"[", 
     RowBox[{"2", ";;", "16"}], "]"}], "]"}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ifun", "=", 
    RowBox[{"Interpolation", "[", 
     RowBox[{"pts", ",", 
      RowBox[{"InterpolationOrder", "\[Rule]", "10"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Plot1", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"ifun", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "1", ",", "12"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Filling", "->", "Axis"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FillingStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.2", "]"}], ",", "PostEmergenceColour"}], 
        "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"PostEmergenceColour", ",", 
         RowBox[{"Thickness", "[", "MyThickness", "]"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "MyAspectRatio"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "12"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1.3"}], ",", "1.3"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"Axes", "\[Rule]", 
       RowBox[{"{", "False", "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Plot2", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"ifun", "[", "x", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "1", ",", "12"}], "}"}], ",", 
      RowBox[{"Epilog", "\[Rule]", 
       RowBox[{"Point", "[", "pts", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"Filling", "\[Rule]", "Axis"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FillingStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.2", "]"}], ",", "PostEmergenceColour"}], 
        "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"PostEmergenceColour", ",", 
         RowBox[{"Thickness", "[", "MyThickness", "]"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "MyAspectRatio"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "12"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1.3"}], ",", "1.3"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"Axes", "\[Rule]", 
       RowBox[{"{", "False", "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"PostEmergencePlot", "=", 
  RowBox[{"Show", "[", "Plot1", "]"}]}]}], "Input",
 CellChangeTimes->{
  3.8784133888165493`*^9, {3.878413621443941*^9, 3.878413671057521*^9}, {
   3.8784137052384415`*^9, 3.878413719618266*^9}, {3.878413780478152*^9, 
