  3.87841739753304*^9}, {3.878429492523237*^9, 3.878429500413083*^9}}],

Cell["\<\
Hibernation cluster observations are in row 10 (which is data[[10]]). \
\>", "Text",
 CellChangeTimes->{
  3.878414214725915*^9, {3.8784167813643064`*^9, 3.8784167868188267`*^9}, {
   3.878417411143673*^9, 3.878417417763829*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"MyRow", "=", "10"}], ";"}]], "Input",
 CellChangeTimes->{{3.8784142190936923`*^9, 3.8784142242712765`*^9}, 
   3.8784167887902484`*^9, {3.878417419572849*^9, 3.878417419895917*^9}}],

Cell["Transpose the points, so that it is in a usable format:", "Text",
 CellChangeTimes->{{3.878410756243881*^9, 3.878410766997532*^9}, {
  3.8784108021181097`*^9, 3.878410821053404*^9}, {3.8784132552438354`*^9, 
  3.878413276138863*^9}, {3.8784137666170473`*^9, 3.8784137738826423`*^9}, {
  3.878413943653152*^9, 3.8784139564327006`*^9}, {3.8784142080616317`*^9, 
  3.878414217278143*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pts", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"data", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", 
      FractionBox[
       RowBox[{"data", "[", 
        RowBox[{"[", "MyRow", "]"}], "]"}], 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"data", "[", 
          RowBox[{"[", "MyRow", "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]]}], "}"}], "]"}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pts", "=", 
   RowBox[{"pts", "[", 
    RowBox[{"[", 
     RowBox[{"2", ";;", "16"}], "]"}], "]"}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ifun", "=", 
    RowBox[{"Interpolation", "[", 
     RowBox[{"pts", ",", 
      RowBox[{"InterpolationOrder", "\[Rule]", "10"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Plot1", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"ifun", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "1", ",", "12"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Filling", "->", "Axis"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FillingStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.1", "]"}], ",", 
         "HibernationClusterColour"}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"Black", ",", "Dotted"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "MyAspectRatio"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "12"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1.3"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"Axes", "\[Rule]", 
       RowBox[{"{", "False", "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Plot2", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"ifun", "[", "x", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "1", ",", "12"}], "}"}], ",", 
      RowBox[{"Epilog", "\[Rule]", 
       RowBox[{"Point", "[", "pts", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"Filling", "\[Rule]", "Axis"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FillingStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.2", "]"}], ",", 
         "HibernationClusterColour"}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"HibernationClusterColour", ",", "Dashed"}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "MyAspectRatio"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "12"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1.3"}], ",", "0"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"Axes", "\[Rule]", 
       RowBox[{"{", "False", "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"HibernationClusterPlot", "=", 
  RowBox[{"Show", "[", 
   RowBox[{"EmptyPlot", ",", "Plot1"}], "]"}]}]}], "Input",
