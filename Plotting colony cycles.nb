Cell[CellGroupData[{

Cell["(1) Plotting total observations:", "Section",
 CellChangeTimes->{{3.8784107704028244`*^9, 3.8784107936586847`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"MyRow", "=", "2"}], ";"}]], "Input",
 CellChangeTimes->{{3.8784149690038495`*^9, 3.878414970758774*^9}}],

Cell["\<\
Total observations are in row 2 (which is data[[2]]). 

Transpose the points, so that it is in a usable format. I will also scale \
each set of observations as a proportion of the highest value for that \
observation type:\
\>", "Text",
 CellChangeTimes->{{3.878410756243881*^9, 3.878410766997532*^9}, {
  3.8784108021181097`*^9, 3.878410821053404*^9}, {3.8784150134427376`*^9, 
  3.8784150350380692`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pts", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"data", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       FractionBox[
        RowBox[{"data", "[", 
         RowBox[{"[", "MyRow", "]"}], "]"}], 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"data", "[", 
           RowBox[{"[", "MyRow", "]"}], "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]]}], "}"}], "]"}]}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"data", "[", 
     RowBox[{"[", "1", "]"}], "]"}], " ", "is", " ", "the", " ", 
    RowBox[{"month", ".", " ", "The"}], " ", "second", " ", "part", " ", "is",
     " ", "the", " ", "variable", " ", 
    RowBox[{"we", "'"}], "re", " ", "interested", " ", "in", " ", 
    RowBox[{"plotting", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"pts", "=", 
  RowBox[{"pts", "[", 
   RowBox[{"[", 
    RowBox[{"2", ";;", "16"}], "]"}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Removes", " ", "the", " ", "first", " ", "bit"}], ",", " ", 
    RowBox[{"which", " ", "is", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Month\>\"", ",", "\"\<Total observations\>\""}], "}"}]}]}],
    "*)"}]}]}], "Input",
 CellChangeTimes->{{3.878410017137616*^9, 3.878410050058525*^9}, {
