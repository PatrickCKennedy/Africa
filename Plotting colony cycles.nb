Cell["\<\
To generate a smooth function, we will use the Interpolation function in \
Mathematica:\
\>", "Text",
 CellChangeTimes->{{3.8784108407007804`*^9, 3.8784108593381147`*^9}, {
  3.8784124598464055`*^9, 3.8784124629249053`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ifun", "=", 
    RowBox[{"Interpolation", "[", 
     RowBox[{"pts", ",", 
      RowBox[{"InterpolationOrder", "\[Rule]", "10"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"ifun", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "1", ",", "12"}], "}"}], ",", 
    RowBox[{"Epilog", "\[Rule]", 
     RowBox[{"Point", "[", "pts", "]"}]}], ",", 
    RowBox[{"Filling", "->", "Axis"}], ",", 
    RowBox[{"AspectRatio", "\[Rule]", 
     RowBox[{"1", "/", "10"}]}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "12"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1.3"}], ",", "1.3"}], "}"}]}], "}"}]}]}], "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"That", " ", "shows", " ", "whether", " ", "it", " ", 
     RowBox[{"works", ".", " ", "We"}], " ", 
     RowBox[{"don", "'"}], "t", " ", "want", " ", "to", " ", "include", " ", 
     "the", " ", "points"}], ",", " ", "however", ",", " ", 
    RowBox[{"in", " ", "the", " ", "actual", " ", "plot"}], ",", " ", 
    RowBox[{
    "which", " ", "is", " ", "exactly", " ", "the", " ", "same", " ", "just", 
     " ", "without", " ", "the", " ", "Epilog", " ", "part", " ", "and", " ", 
     "the", " ", 
     RowBox[{"axes", ":"}]}]}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot1", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"ifun", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "1", ",", "12"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Filling", "->", "Axis"}], ",", "\[IndentingNewLine]", 
    RowBox[{"FillingStyle", "\[Rule]", 
     RowBox[{"Directive", "[", 
      RowBox[{
       RowBox[{"Opacity", "[", "0.5", "]"}], ",", "AllObservationsColour"}], 
      "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", "AllObservationsColour"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "\[Rule]", "MyAspectRatio"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", 
