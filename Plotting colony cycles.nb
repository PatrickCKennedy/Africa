Cell[CellGroupData[{

Cell["(4) Plotting off-nest females:", "Section",
 CellChangeTimes->{{3.8784107704028244`*^9, 3.8784107936586847`*^9}, {
  3.8784132354172964`*^9, 3.8784132529099474`*^9}, {3.8784137398154984`*^9, 
  3.878413744628504*^9}, {3.8784139358359256`*^9, 3.8784139412551336`*^9}}],

Cell["\<\
Post-emergence nest observations are in row 3 (which is data[[3]]). \
\>", "Text",
 CellChangeTimes->{3.878414214725915*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"MyRow", "=", "3"}], ";"}]], "Input",
 CellChangeTimes->{{3.8784142190936923`*^9, 3.8784142242712765`*^9}}],

Cell["Transpose the points, so that it is in a usable format:", "Text",
 CellChangeTimes->{{3.878410756243881*^9, 3.878410766997532*^9}, {
  3.8784108021181097`*^9, 3.878410821053404*^9}, {3.8784132552438354`*^9, 
  3.878413276138863*^9}, {3.8784137666170473`*^9, 3.8784137738826423`*^9}, {
  3.878413943653152*^9, 3.8784139564327006`*^9}, {3.8784142080616317`*^9, 
  3.878414217278143*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pts", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"data", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", 
      FractionBox[
       RowBox[{"data", "[", 
        RowBox[{"[", "MyRow", "]"}], "]"}], 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"data", "[", 
          RowBox[{"[", "MyRow", "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]]}], "}"}], "]"}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pts", "=", 
   RowBox[{"pts", "[", 
    RowBox[{"[", 
     RowBox[{"2", ";;", "16"}], "]"}], "]"}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ifun", "=", 
    RowBox[{"Interpolation", "[", 
     RowBox[{"pts", ",", 
      RowBox[{"InterpolationOrder", "\[Rule]", "10"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Plot1", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"ifun", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "1", ",", "12"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Filling", "->", "Axis"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FillingStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.4", "]"}], ",", "OffNestFemaleColour"}], 
        "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"OffNestFemaleColour", ",", 
         RowBox[{"Thickness", "[", "MyThickness", "]"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "MyAspectRatio"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "12"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1.3"}], ",", "1.3"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"Axes", "\[Rule]", 
       RowBox[{"{", "False", "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Plot2", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"ifun", "[", "x", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "1", ",", "12"}], "}"}], ",", 
      RowBox[{"Epilog", "\[Rule]", 
       RowBox[{"Point", "[", "pts", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"Filling", "\[Rule]", "Axis"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FillingStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.1", "]"}], ",", "OffNestFemaleColour"}], 
        "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"OffNestFemaleColour", ",", 
         RowBox[{"Thickness", "[", "MyThickness", "]"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "MyAspectRatio"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "12"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1.3"}], ",", "1.3"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"Axes", "\[Rule]", 
       RowBox[{"{", "False", "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"OffNestFemalePlot", "=", 
  RowBox[{"Show", "[", 
   RowBox[{"InvertedEmptyPlot", ",", "Plot2"}], "]"}]}]}], "Input",
 CellChangeTimes->{
