Cell["\<\
I would like to make this graph symmetrical around the origin, as a fun way \
of plotting the data:\
\>", "Text",
 CellChangeTimes->{{3.878412498381572*^9, 3.878412520052698*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ifun", "=", 
    RowBox[{"Interpolation", "[", 
     RowBox[{"pts", ",", 
      RowBox[{"InterpolationOrder", "\[Rule]", "10"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Plot2", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"ifun", "[", "x", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "1", ",", "12"}], "}"}], ",", 
      RowBox[{"Epilog", "\[Rule]", 
       RowBox[{"Point", "[", "pts", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"Filling", "\[Rule]", "Axis"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FillingStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.5", "]"}], ",", "AllObservationsColour"}],
         "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "\[Rule]", "AllObservationsColour"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "MyAspectRatio"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "12"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1.3"}], ",", "1.3"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"Axes", "\[Rule]", 
       RowBox[{"{", "False", "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"AllObservationsPlot", "=", 
  RowBox[{"Show", "[", 
   RowBox[{"Plot1", ",", "Plot2"}], "]"}]}]}], "Input",
