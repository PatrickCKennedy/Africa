# PK
# SCRIPT FOR RUNNING ON THE LOCAL MACHINE, FOR EXTRACTING MITOCHONDRIAL GENOMES FROM EACH WASP'S TRIMMED FASTA FILES:

# We will use 'MitoZ' (https://github.com/linzhi2013/MitoZ)
# I have installed MitoZ on the local computer using Docker (i.e., docker pull guanliangmeng/mitoz:3.6), following https://github.com/linzhi2013/MitoZ/wiki/Installation

# -----------------------------------------------------
# OPTION 1: IF RUNNING ON JUST A SINGLE WASP OF INTEREST:

# Navigate to the folder containing the (adaptor-trimmed) fastq files for the wasp of interest:
cd /Users/pk14885/Desktop/Testing_MitoZ_again_on_L9_a

# Automatically detect the (adaptor-trimmed) forward file:
this_wasp_val_1_file=$(ls *val_1*)

# Automatically detect the (adaptor-trimmed) reverse file:
this_wasp_val_2_file=$(ls *val_2*)

# Run MitoZ in Docker (the current directory is given by $PWD): 
docker run -v $PWD:$PWD -w $PWD --rm guanliangmeng/mitoz:3.6  mitoz all \
--fq1 $PWD/$this_wasp_val_1_file \
--fq2 $PWD/$this_wasp_val_2_file \
--outprefix Patrick_MitoZ_ \
--clade Arthropoda \
--fastq_read_length 151 \
--assembler megahit \
--requiring_taxa Arthropoda

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# SPECIES IDENTIFICATION FOR THAT SAMPLE VIA BOLD:
# You can either do this via the BOLD website (https://boldsystems.org/index.php/IDS_OpenIdEngine), by simply inputting the sequences output by MitoZ above, or do exactly the same call to BOLD using the 'mitoz-tools bold_identification' command on the output fasta file:

docker run -v $PWD:$PWD -w $PWD --rm guanliangmeng/mitoz:3.6  mitoz-tools bold_identification \
-i Patrick_MitoZ_.result/Patrick_MitoZ_.Patrick_MitoZ_.megahit.mitogenome.fa.result/Patrick_MitoZ__Patrick_MitoZ_.megahit.mitogenome.fa_mitoscaf.fa.gbf.fasta -o Patrick_BOLD_call_ \
-r 1000 -n 20

# Here, we have kept the first 20 hits ('-n 20'), which you can now see in the following file:
cat Patrick_BOLD_call_.taxa

